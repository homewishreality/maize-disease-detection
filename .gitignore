!data/dataset_provenance.json

# --- generated artefacts: results, figures, checkpoints, weights ---
# Uncomment to keep these out of git entirely. They are your experimental record, so many students
# prefer to commit the small ones (results/*.csv, results/*.json, reports/) and ignore only the big ones.
outputs/checkpoints/
*.keras
*.h5
*.zip

